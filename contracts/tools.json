{
  "passbolt_status": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Probe Passbolt auth and a v5 decrypt canary. Use before first real task. Returns booleans only; never secrets."
  },
  "passbolt_search": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "query": {
          "type": "string"
        },
        "target_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "default": 20,
          "type": "integer"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Search resource metadata (name, URI, username) within policy. Use to find a credential; then `passbolt_select`. Never returns passwords."
  },
  "passbolt_select": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "target_url": {
          "type": "string"
        },
        "query": {
          "default": "",
          "type": "string"
        },
        "limit": {
          "default": 10,
          "type": "integer"
        }
      },
      "required": [
        "target_url"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Bind one matching resource to this principal and exact target URL; returns selection_id. Use before `passbolt_use_secret`. Metadata only."
  },
  "passbolt_create_resource": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "secret_source": {
          "additionalProperties": true,
          "type": "object"
        },
        "idempotency_key": {
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "folder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_with_groups": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_with_users": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_mode": {
          "default": "explicit",
          "type": "string"
        },
        "resource_type": {
          "default": "v5-default",
          "type": "string"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "uri",
        "username",
        "secret_source",
        "idempotency_key"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Create a v5 resource with a server_generated or sealed_ref secret (no plaintext input). Use for onboarding. Writes: idempotent, within policy."
  },
  "passbolt_update_resource": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "fields": {
          "additionalProperties": true,
          "type": "object"
        },
        "expected_modified": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "resource_id",
        "fields",
        "expected_modified",
        "idempotency_key"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Update a resource (approval-gated, optimistic concurrency). First call returns approval_id; repeat after operator acceptance. Writes: overwrites."
  },
  "passbolt_create_folder": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "parent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_with_groups": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_with_users": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_mode": {
          "default": "explicit",
          "type": "string"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name",
        "idempotency_key"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Create one folder idempotently; group refs are UUIDs. Use for client onboarding. Writes: within folder policy."
  },
  "passbolt_share_resource": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "resource_id": {
          "type": "string"
        },
        "permission": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "groups": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "users": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "share_mode": {
          "default": "explicit",
          "type": "string"
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "resource_id",
        "permission",
        "idempotency_key"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Share a resource with groups/users (approval-gated; UUID refs). First call returns approval_id; operator accepts outside MCP. Writes: grants access."
  },
  "passbolt_use_secret": {
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "selection_id": {
          "type": "string"
        },
        "sink_ref": {
          "type": "string"
        },
        "target_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "selection_id",
        "sink_ref"
      ],
      "type": "object"
    },
    "outputSchema": {
      "additionalProperties": true,
      "type": "object"
    },
    "description": "Deliver a selected secret to one registered sink (secure_fill/out_file/https_probe). Use to log in or hand off; the secret never enters the chat. Requires passbolt:use."
  }
}
