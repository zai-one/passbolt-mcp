# One server-custody vault profile. Copy to a private server path with mode 0600.
# The private key remains inside the referenced 0700 GPG home; passphrase and
# JWT state never become MCP arguments or client environment variables.
PASSBOLT_BASE_URL=https://passbolt.example
PASSBOLT_SERVICE_USER_ID=<service-user-uuid>
PASSBOLT_SERVICE_USERNAME=<safe-service-username>
PASSBOLT_USER_FINGERPRINT=<40-hex-service-key-fingerprint>
PASSBOLT_SERVER_FINGERPRINT=<40-hex-pinned-server-fingerprint>
PASSBOLT_METADATA_FINGERPRINTS=<comma-separated-pinned-metadata-key-fingerprints>
PASSBOLT_GPG_HOME=/run/secrets/passbolt/profiles/owner_one/gnupg
PASSBOLT_PASSPHRASE_FILE=/run/secrets/passbolt/profiles/owner_one/passphrase
PASSBOLT_SINK_CONFIG_FILE=/run/secrets/passbolt/profiles/owner_one/policy-sinks.json
PASSBOLT_TOKEN_STATE_FILE=/run/state/passbolt-profiles/owner_one/tokens.json
PASSBOLT_SEALED_REF_DIR=/run/secrets/passbolt-profile-ingress/owner_one
PASSBOLT_DOMAIN_ALLOWLIST=
